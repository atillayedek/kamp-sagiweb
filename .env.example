# Yalnızca değişken ADLARI. Gerçek değerleri buraya veya git'e yazma.
# Web: apps/web/.env.local dosyasına kopyala.

NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ALLOW_INDEXING=false

NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_APPCHECK_RECAPTCHA_ENTERPRISE_SITE_KEY=

# Cloud Functions gizli değerleri .env dosyasına YAZILMAZ; yalnızca Secret Manager'da tutulur:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
