rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isOwner(ownerUid) {
      return isSignedIn() && uid() == ownerUid;
    }

    function isModerator() {
      return isSignedIn() && request.auth.token.get('moderator', false) == true;
    }

    function isVerified() {
      return isSignedIn()
        && request.auth.token.get('verified', false) == true
        && request.auth.token.get('universityId', null) is string;
    }

    function myUniversity() {
      return request.auth.token.universityId;
    }

    function sameUniversity(data) {
      return isVerified() && data.universityId == myUniversity();
    }

    function canSee(data) {
      return isVerified() && (data.visibility == 'global' || data.universityId == myUniversity());
    }

    function incoming() {
      return request.resource.data;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isNow(value) {
      return value == request.time;
    }

    function validVisibility(data) {
      return data.visibility in ['campus', 'global'] && data.universityId == myUniversity();
    }

    function post(postId) {
      return get(/databases/$(database)/documents/posts/$(postId)).data;
    }

    function club(clubId) {
      return get(/databases/$(database)/documents/clubs/$(clubId)).data;
    }

    function event(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data;
    }

    function conversation(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    function blocked(ownerUid, targetUid) {
      return exists(/databases/$(database)/documents/blocks/$(ownerUid)/blocked/$(targetUid));
    }

    match /universities/{universityId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isModerator() || sameUniversity(resource.data);
      allow list: if isModerator();
      allow write: if false;
    }

    match /userPrivate/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /verificationRequests/{requestId} {
      allow read: if isModerator() || (isSignedIn() && resource.data.uid == uid());
      allow write: if false;
    }

    match /moderationLogs/{logId} {
      allow read: if isModerator();
      allow write: if false;
    }

    match /needs/{needId} {
      allow read: if canSee(resource.data);
      allow write: if false;

      match /matches/{candidateUid} {
        function need() {
          return get(/databases/$(database)/documents/needs/$(needId)).data;
        }

        allow read: if isVerified()
          && ((candidateUid == uid() && resource.data.status == 'suggested') || need().authorUid == uid());
        allow update: if isVerified()
          && need().authorUid == uid()
          && changedKeys().hasOnly(['status'])
          && incoming().status == 'dismissed';
        allow create, delete: if false;
      }
    }

    match /{path=**}/matches/{matchId} {
      allow read: if isVerified() && resource.data.candidateUid == uid() && resource.data.status == 'suggested';
    }

    match /posts/{postId} {
      allow read: if canSee(resource.data);
      allow create: if isVerified()
        && incoming().keys().hasOnly(['authorUid', 'universityId', 'visibility', 'text', 'likeCount', 'commentCount', 'createdAt'])
        && incoming().authorUid == uid()
        && validVisibility(incoming())
        && isText(incoming().text, 1, 1000)
        && incoming().likeCount == 0
        && incoming().commentCount == 0
        && isNow(incoming().createdAt);
      allow update, delete: if false;

      match /comments/{commentId} {
        allow read: if canSee(post(postId));
        allow create: if canSee(post(postId))
          && incoming().keys().hasOnly(['authorUid', 'text', 'createdAt'])
          && incoming().authorUid == uid()
          && isText(incoming().text, 1, 500)
          && isNow(incoming().createdAt);
        allow update, delete: if false;
      }

      match /likes/{likerUid} {
        allow read: if canSee(post(postId));
        allow create: if likerUid == uid()
          && canSee(post(postId))
          && incoming().keys().hasOnly(['createdAt'])
          && isNow(incoming().createdAt);
        allow delete: if isVerified() && likerUid == uid();
        allow update: if false;
      }
    }

    match /clubs/{clubId} {
      allow read: if canSee(resource.data);
      allow write: if false;

      match /members/{memberUid} {
        allow read: if canSee(club(clubId));
        allow create: if memberUid == uid()
          && canSee(club(clubId))
          && incoming().keys().hasOnly(['joinedAt'])
          && isNow(incoming().joinedAt);
        allow delete: if isVerified() && memberUid == uid();
        allow update: if false;
      }
    }

    match /events/{eventId} {
      allow read: if canSee(resource.data);
      allow write: if false;

      match /attendees/{attendeeUid} {
        allow read: if canSee(event(eventId));
        allow create: if attendeeUid == uid()
          && canSee(event(eventId))
          && incoming().keys().hasOnly(['joinedAt'])
          && isNow(incoming().joinedAt);
        allow delete: if isVerified() && attendeeUid == uid();
        allow update: if false;
      }
    }

    match /conversations/{conversationId} {
      allow read: if isVerified() && uid() in resource.data.participants;
      allow write: if false;

      match /messages/{messageId} {
        function canMessage(conv) {
          let other = conv.participants[0] == uid() ? conv.participants[1] : conv.participants[0];
          let allowFrom = get(/databases/$(database)/documents/userPrivate/$(other)).data.messaging.allowFrom;
          return conv.participants.size() == 2
            && uid() in conv.participants
            && !blocked(other, uid())
            && !blocked(uid(), other)
            && (allowFrom == 'everyone'
              || (allowFrom == 'campus' && get(/databases/$(database)/documents/users/$(other)).data.universityId == myUniversity()));
        }

        allow read: if isVerified() && uid() in conversation(conversationId).participants;
        allow create: if isVerified()
          && canMessage(conversation(conversationId))
          && incoming().keys().hasOnly(['senderUid', 'text', 'createdAt'])
          && incoming().senderUid == uid()
          && isText(incoming().text, 1, 2000)
          && isNow(incoming().createdAt);
        allow update, delete: if false;
      }
    }

    match /notifications/{ownerUid}/items/{notificationId} {
      allow read: if isOwner(ownerUid);
      allow update: if isOwner(ownerUid)
        && changedKeys().hasOnly(['read'])
        && incoming().read == true;
      allow create, delete: if false;
    }

    match /blocks/{ownerUid}/blocked/{targetUid} {
      allow read: if isOwner(ownerUid);
      allow create: if isOwner(ownerUid)
        && targetUid != ownerUid
        && incoming().keys().hasOnly(['createdAt'])
        && isNow(incoming().createdAt);
      allow delete: if isOwner(ownerUid);
      allow update: if false;
    }

    match /reports/{reportId} {
      allow read: if isModerator();
      allow write: if false;
    }

    match /dataExports/{ownerUid}/jobs/{jobId} {
      allow read: if isOwner(ownerUid);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
